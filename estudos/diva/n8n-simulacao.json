      "parameters": {
        "jsCode": "const seen=new Set(); let total=0; for(const {json:r} of $input.all()){if(r.confirmed!==true || r.kind!==\"expense\" || !Number.isSafeInteger(r.cents)||r.cents<=0) throw new Error(\"Registro invalido\"); if(!seen.has(r.id)){seen.add(r.id);total+=r.cents;}} return [{json:{total_cents:total,registros:seen.size,modo:\"simulacao sem persistencia\"}}];"
      },
