    {
      "name": "Interpretar comando",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "function parse(text, today){\n const s=String(text||'').trim(); if(s.length>500) throw Error('Limite de 500 caracteres');\n if(/^total$/i.test(s)) return {op:'total',month:today.slice(0,7)};\n if(/^listar (notas|tarefas)$/i.test(s)) return {op:'list',kind:/notas/i.test(s)?'note':'task'};\n const p=s.split('|').map(x=>x.trim()); const cmd=p[0].toLowerCase();\n if(!['despesa','receita','nota','tarefa'].includes(cmd)) throw Error('Use despesa|ID|valor|categoria|titulo; receita|ID|valor|categoria|titulo; nota|ID|texto; tarefa|ID|texto|AAAA-MM-DD; total; listar notas; listar tarefas.');\n if(!/^[A-Za-z0-9_-]{1,40}$/.test(p[1]||'')) throw Error('ID invalido');\n const fin=['despesa','receita'].includes(cmd); if(p.length!==(fin?5:cmd==='nota'?3:4)) throw Error('Campos incompletos');\n let r={op:'write',ref:p[1],kind:({despesa:'expense',receita:'income',nota:'note',tarefa:'task'})[cmd],title:fin?p[4]:p[2],cents:0,category:fin?p[3]:'',day:today,due:cmd==='tarefa'?p[3]:'',status:'open'};\n if(!r.title|| (fin&&!r.category)) throw Error('Titulo ou categoria ausente');\n if(fin){if(!/^\\d{1,7}([,.]\\d{1,2})?$/.test(p[2])) throw Error('Valor invalido'); const v=p[2].replace(',','.').split('.'); r.cents=Number(v[0])*100+Number((v[1]||'').padEnd(2,'0')); if(r.cents<=0) throw Error('Valor deve ser positivo');}\n if(r.due && (!/^\\d{4}-\\d{2}-\\d{2}$/.test(r.due)||!Number.isFinite(Date.parse(r.due))||new Date(r.due).toISOString().slice(0,10)!==r.due)) throw Error('Data invalida'); return r;\n}\ntry {return [{json:parse($input.first().json.chatInput,$now.setZone('America/Sao_Paulo').toISODate())}];} catch(e){return [{json:{op:'error',output:e.message}}];}"
      },
      "position": [
        240,
        0
      ],
      "id": "2aa6dc7f-8641-4002-9389-5656df1e3f6d"
    },
