    {
      "name": "Responder consulta",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "function summarize(q,rows){ const rr=rows.filter(r=>r.ref); if(q.op==='total'){const a=rr.filter(r=>r.day.startsWith(q.month)); let e=0,i=0; for(const r of a){if(!Number.isSafeInteger(r.cents)||r.cents<0) throw Error('Registro monetario invalido');if(r.kind==='expense')e+=r.cents;if(r.kind==='income')i+=r.cents;} return `Mes ${q.month}: despesas R$ ${(e/100).toFixed(2)}, receitas R$ ${(i/100).toFixed(2)}.`;} return rr.filter(r=>r.kind===q.kind).map(r=>`${r.ref}: ${r.title}${r.due?' — '+r.due:''}`).join('\\n')||'Nenhum registro.';}\nreturn [{json:{output:summarize($('Interpretar comando').first().json,$input.all().map(x=>x.json))}}];"
      },
      "position": [
        960,
        120
      ],
      "id": "e6d52c95-df98-4683-970b-59dc35fe9461"
